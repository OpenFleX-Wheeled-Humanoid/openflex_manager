btn_bg=#a8b0bd
btn_text=#111827
btn_hover_bg=#c4cad4
btn_pressed_bg=#8b93a1
btn_disabled_bg=#d1d5db
btn_disabled_text=#6b7280
btn_border=#9ca3af
input_bg=#ffffff
tab_bg=#f3f6fb
tab_selected_bg=#ffffff
menu_bg=#ffffff
menu_hover_bg=#e8eefc
log_info_color=#1f2937
log_success_color=#16a34a
